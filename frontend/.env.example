# Vercel: Project Settings > Environment Variables (set for Production AND Preview)

# Origin of the backend on Plesk. Browser calls /api/* on the Vercel domain and Next.js
# rewrites them here, so auth cookies stay first-party. No trailing slash.
BACKEND_URL=http://localhost:4000

# Optional "direct mode": only when frontend and backend share a parent domain
# (app.example.com + api.example.com) and you want the browser to call the API directly.
# Leave EMPTY to use the rewrite above (recommended). Requires backend COOKIE_DOMAIN=.example.com
NEXT_PUBLIC_API_URL=

# Same random value as backend ECOMMERCE_AUTH_PROXY_SECRET. Server-only; never prefix with NEXT_PUBLIC_.
ECOMMERCE_AUTH_PROXY_SECRET=
# Set to .example.com only when using direct API mode with shared parent-domain cookies.
COOKIE_DOMAIN=
