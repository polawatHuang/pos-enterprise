# ---------------------------------------------------------------------------
# Backend environment. Local dev: copy to .env. On Plesk: enter each variable in
# Websites & Domains > Node.js > "Custom environment variables" (no .env file needed).
# Generate secrets with:  npm run gen-secret
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Number of reverse proxies in front of Node (Plesk nginx -> Apache/Passenger = 1 is typical)
TRUST_PROXY=1

# --- MySQL (Plesk: Databases > Add Database; host is usually localhost) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=pos
DB_PASSWORD=
DB_NAME=pos_enterprise
DB_CONNECTION_LIMIT=5

# --- Auth ---
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=14

# Frontend origins allowed by CORS (comma separated, * matches one subdomain label)
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app,https://*-your-team.vercel.app
# Leave COOKIE_DOMAIN empty when the frontend proxies /api via Vercel rewrites (recommended).
# Set to .example.com only if app.example.com calls api.example.com directly.
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax
# false only for plain-http local testing in browsers that reject Secure cookies on http
COOKIE_SECURE=false

# --- Background jobs ---
CRON_SECRET=change-me-cron-secret-32-chars-min
# cron = Plesk Scheduled Task drives the queue; inprocess = VPS with an always-on process
JOB_RUNNER=cron
APP_TZ_OFFSET=+07:00
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# --- Third-party integrations (see docs/API_KEYS.md). Leave empty until you have them. ---
# AI provider for every AI feature: minimax (default) or anthropic
AI_PROVIDER=minimax
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3
# Mainland China accounts: https://api.minimaxi.com/anthropic
MINIMAX_BASE_URL=https://api.minimax.io/anthropic
# AI video (same MiniMax key): speech + Hailuo clips via the native API
MINIMAX_API_HOST=https://api.minimax.io
MINIMAX_TTS_MODEL=speech-2.6-hd
# Default voice for voice-overs (pick one in the MiniMax console; test Thai pronunciation first)
MINIMAX_VOICE_ID=
# auto, or a language name from MiniMax's language_boost list
MINIMAX_TTS_LANGUAGE=auto
MINIMAX_VIDEO_MODEL=MiniMax-Hailuo-2.3
# Only for older accounts that still require GroupId on media endpoints
MINIMAX_GROUP_ID=
# Optional alternative provider (AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Register exactly this in the TikTok app: https://<web app>/api/social/oauth/tiktok/callback
TIKTOK_REDIRECT_URI=
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=

SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_REDIRECT_URL=
SHOPEE_AFFILIATE_APP_ID=
SHOPEE_AFFILIATE_SECRET=
# Optional override of the GraphQL endpoint (default: https://open-api.affiliate.shopee.co.th/graphql)
SHOPEE_AFFILIATE_ENDPOINT=

META_APP_ID=
META_APP_SECRET=
# Facebook Login redirect for Reels publishing: https://<web app>/api/social/oauth/meta/callback
META_REDIRECT_URI=
# Public origin of the web app (OAuth callbacks redirect back here)
APP_PUBLIC_URL=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0
# Single-page installs; per-channel tokens can instead be saved (encrypted) in Inbox settings
META_PAGE_ACCESS_TOKEN=

LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Public HTTPS origin of this API: webhook URL in Inbox settings, and the base of the
# signed links the video renderer uses to fetch "my footage" uploads and covers
PUBLIC_API_URL=
# Where uploaded video footage is stored on disk (default backend/storage/media)
MEDIA_DIR=

HEYGEN_API_KEY=
HEYGEN_DEFAULT_AVATAR_ID=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
SHOTSTACK_API_KEY=
SHOTSTACK_ENV=stage
# Optional: TTF font for Thai captions (default Sarabun Bold from Google Fonts) and background music
SHOTSTACK_FONT_URL=
VIDEO_MUSIC_URL=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

APIFY_TOKEN=
